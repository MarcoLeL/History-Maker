# La trascrizione (fase 3) usa Gemini sul piano gratuito di Google AI
# Studio. Serve una chiave, che e' gratuita e si prende in un minuto su
#   https://aistudio.google.com/apikey
#
# Non va messa in nessun file del progetto: si imposta come variabile
# d'ambiente prima di lanciare il comando.
#
#   PowerShell:  $env:GEMINI_API_KEY = "la-tua-chiave"
#   bash:        export GEMINI_API_KEY="la-tua-chiave"
#
# GEMINI_API_KEY=...          (accettata anche come GOOGLE_API_KEY)

# Con 'backend: claude-code' in config/torrebruna.yaml la fase 3 usa
# invece l'abbonamento Claude Pro tramite Claude Code, e allora non serve
# nessuna chiave: basta autenticarsi una volta lanciando 'claude'.

# Facoltativo: percorso di un binario Chrome/Chromium non standard
# CHROME_BINARY=/usr/bin/chromium

# Facoltativo: chromedriver esplicito, se Selenium non riesce a
# scaricarlo da solo o la versione non combacia con quella di Chrome
# CHROMEDRIVER=/percorso/di/chromedriver
