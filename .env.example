# Facoltativo: percorso di un binario Chrome/Chromium non standard
# CHROME_BINARY=/usr/bin/chromium

# Facoltativo: chromedriver esplicito, se Selenium non riesce a
# scaricarlo da solo o la versione non combacia con quella di Chrome
# CHROMEDRIVER=/percorso/di/chromedriver
