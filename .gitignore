# I dati: immagini, database, cache. Sono gigabyte e si riproducono con la
# pipeline; il repository tiene il codice che li fa.
#
# Le trascrizioni no: sono quarantadue mega di testo, e da sole rifanno il
# database con la fase 'dataset'. Provato il 24 settembre 2026: ricostruito
# da capo in una cartella a parte, tutte e 52047 le righe di 'persone'
# tornano con lo STESSO id, e gli id delle righe sono cio' a cui puntano le
# decisioni prese sull'immagine. Senza di loro un clone non puo' ricostruire
# niente, e le decisioni non avrebbero dove attaccarsi.
/data/*
!/data/trascrizioni/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Strumenti. '.idea/' NON sta qui: le configurazioni di PyCharm sono
# versionate di proposito (vedi docs/prima-esecuzione.md), cosi' chi apre
# il progetto nell'IDE trova l'interprete e i comandi gia' pronti.
.pytest_cache/

# File di lavoro sparsi nella radice (scr_*.pkl, scr_*.json)
/scr_*

# Le immagini pescate dalla coda: si rifanno con rari_lotto.py
/strumenti/coda/lotto/
/strumenti/coda/p_*.jpg
/strumenti/coda/qualita_*.md
/strumenti/coda/*.json.bak
# I ritagli e i rapporti di un giro di coda: si rifanno
/strumenti/coda/v_*.jpg
/strumenti/coda/*.log
/strumenti/coda/analisi_*.json
